{
  "name": "lilia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "start": "bun apps/api/src/server.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:inspect": "bun scripts/inspect-database.ts",
    "db:generate-key": "bun scripts/generate-signing-key.ts",
    "devnet:setup": "bun scripts/devnet/setup.ts",
    "devnet:verify": "bun scripts/devnet/verify.ts",
    "devnet:cleanup": "bun scripts/devnet/cleanup.ts",
    "mcp": "bun apps/mcp/src/index.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.4",
    "@types/node": "^22.13.4",
    "turbo": "^2.9.10",
    "typescript": "^5.7.3"
  },
  "bin": {
    "lilia-mcp": "dist/index.js",
    "lilia-mcp-setup": "dist/setup.js"
  }
}
