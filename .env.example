PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=./database/lilia.db
LILIA_API_KEY=replace_with_secure_random_api_key
LILIA_SIGNING_PRIVATE_KEY=
LILIA_SIGNING_PUBLIC_KEY=
GEMINI_API_KEY=

# Solana
SOLANA_RPC_URL=
SOLANA_RPC_COMMITMENT=confirmed
LILIA_PROGRAM_ID=51yqX5byrtqTYt1MS2cfo98UqPskzmbdW8SEBvj3FTbz
# Base58 Sentinel key trusted on-chain. Derived from the signing key when empty.
LILIA_SENTINEL_PUBLIC_KEY=
# Solana CLI keypair JSON used to administer the program (must match upgrade_authority).
LILIA_ADMIN_KEYPAIR_PATH=
# Inline keypair JSON alternative. Prefer the path in production.
LILIA_ADMIN_KEYPAIR=
LILIA_PERMIT_TTL_SLOTS=300
LILIA_SLOT_TIME_MS=400

# Optional: only for scripts/devnet/* and the MCP server (see docs/ENVIRONMENT.md)
# DEVNET_API_URL=http://127.0.0.1:4000
# LILIA_API_BASE_URL=http://127.0.0.1:4000
# SOLANA_NETWORK=devnet
