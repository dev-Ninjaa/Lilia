              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "agent_registry",
            "docs": [
              "Agent registry this policy belongs to."
            ],
            "type": "pubkey"
          },
          {
            "name": "owner",
            "docs": [
              "Backend owner that published the policy."
            ],
            "type": "pubkey"
          },
          {
            "name": "max_transfer_amount",
            "docs": [
              "Maximum amount in base units."
            ],
            "type": "u64"
          },
          {
            "name": "allowed_mint",
            "docs": [
